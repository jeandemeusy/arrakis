            "as": "share",
            "op": "compute",
            "left": "orders",
            "right": "orders_total",
            "operator": "/"
          },
          {
            "by": [
              {
                "column": "hour"
              },
              {
                "column": "weekday"
              }
            ],
            "op": "sort"
          }
        ],
        "builder": {
          "share": {
            "of": "orders"
          },
          "groups": [
            {
              "unit": "hour_of_day",
              "column": "ordered_at"
            },
            {
              "unit": "day_of_week",
              "column": "ordered_at"
            }
          ],
          "window": {
            "column": "ordered_at"
          },
          "measures": [
