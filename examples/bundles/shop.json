{
  "format": "arrakis-bundle",
  "version": 1,
  "name": "shop",
  "title": "Shop",
  "description": "Orders, revenue and customers of a made-up shop. Works on the demo data source that `npm run dev:db -- --demo` creates (db/demo/shop.sql).",
  "lists": [
    {
      "name": "excluded_countries",
      "type": "text",
      "description": "Country codes left out of every figure: test shops, say."
    }
  ],
  "queries": [
    {
      "slug": "counted-orders",
      "title": "Counted orders",
      "description": "Fragment: every order that counts — not refunded, from a country not in the list excluded_countries — with its customer’s country and region.",
      "kind": "fragment",
      "sql": "-- Every order that counts: not refunded, and from a country that is not in\n-- {{list:excluded_countries}}.\nSELECT o.id, o.customer_id, o.ordered_at, o.status, c.country, k.region\nFROM orders o\nJOIN customers c ON c.id = o.customer_id\nJOIN countries k ON k.code = c.country\nWHERE o.status <> 'refunded'\n  AND c.country <> ALL ({{list:excluded_countries}})",
      "parameters": [],
      "combine": "concat",
      "timeoutSeconds": null
    },
    {
      "slug": "orders",
      "title": "Orders",
      "description": "One row per counted order, with its total and number of items.",
      "kind": "query",
      "sql": "SELECT o.id, o.ordered_at, o.status, o.country, o.region,\n  sum(i.quantity * i.unit_price) AS total,\n  sum(i.quantity) AS items\nFROM {{> counted-orders}} AS o\nJOIN order_items i ON i.order_id = o.id\nGROUP BY o.id, o.ordered_at, o.status, o.country, o.region",
      "parameters": [],
      "refreshSeconds": 3600,
      "rowLimit": null,
      "combine": "concat",
      "timeoutSeconds": null
    },
    {
      "slug": "customers",
      "title": "Customers",
      "description": "One row per customer: where they are, when they signed up and how many orders they placed.",
      "kind": "query",
      "sql": "SELECT c.id, c.signed_up_at, c.country, k.region,\n  count(o.id) AS orders\nFROM customers c\nJOIN countries k ON k.code = c.country\nLEFT JOIN orders o ON o.customer_id = c.id AND o.status <> 'refunded'\nWHERE c.country <> ALL ({{list:excluded_countries}})\nGROUP BY c.id, k.region",
      "parameters": [],
      "refreshSeconds": 3600,
      "rowLimit": null,
      "combine": "concat",
      "timeoutSeconds": null
    },
    {
      "slug": "order-lines",
      "title": "Order lines",
      "description": "One row per product in a counted order.",
      "kind": "query",
      "sql": "SELECT o.ordered_at, o.region, p.name AS product, p.category,\n  i.quantity, i.quantity * i.unit_price AS revenue\nFROM {{> counted-orders}} AS o\nJOIN order_items i ON i.order_id = o.id\nJOIN products p ON p.id = i.product_id",
      "parameters": [],
      "refreshSeconds": 3600,
      "rowLimit": null,
      "combine": "concat",
      "timeoutSeconds": null
    }
  ],
