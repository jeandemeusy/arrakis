{
  "name": "arrakis",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "dev:db": "sh scripts/dev-db.sh",
    "build": "nix develop -c npm run build:nix",
    "build:nix": "next build --webpack",
    "start": "next start",
    "lint": "oxlint app lib instrumentation.ts proxy.ts && stylelint 'app/**/*.css'",
    "test": "node --import ./test/loader.mjs --test 'test/**/*.test.ts'",
    "hash-password": "node scripts/hash-password.mjs",
    "nix:refresh-deps": "sh scripts/refresh-npm-deps-hash.sh",
    "format": "oxfmt && stylelint --fix 'app/**/*.css'"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "lucide-react": "1.31.0",
    "next": "^16.4.4",
    "pg": "^8.16.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "3.8.0"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/pg": "^8.15.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "5.9.3"
  },
  "type": "module"
}
