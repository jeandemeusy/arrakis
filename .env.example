# One or more Blokli index databases.
NETWORKS='[{"id":"jura","label":"Jura","databaseUrl":"postgresql://dashboard:change-me@blokli-db:5432/blokli","rpcUrl":"https://rpc.gnosischain.com"}]'

# Single-network alternative, still supported.
# DATABASE_URL=postgresql://dashboard:change-me@blokli-db:5432/blokli
# RPC_URL=https://rpc.gnosischain.com

# Known exit addresses. Nothing on chain tells an exit apart from a relay — both
# announce — so downstream volume can only be attributed if the exits are named.
# Leave unset and the dashboard falls back to identifying them by elimination,
# which loses any exit that also relays for a client.
#
# EXITS applies to every network; a network may override it with its own list.
# EXITS=0x64885d2d2bc9df7b415aac184e020c632d715dff,0x12b78461da59e8317c61bd249ea0dea2aa9527de

# Render synthetic data instead of querying any database (UI work only).
# Use `degraded` instead of `1` to see the unavailable and partial tile states.
# DASHBOARD_FIXTURES=1

# Query store: the application's own PostgreSQL database for saved queries,
# their results, exits and editor sessions. Separate from every Blokli database.
# APP_DATABASE_URL=postgresql://arrakis:change-me@app-db:5432/arrakis

# Editing is unlocked with one password. Store its hash, never the password:
#   npm run hash-password
# ARRAKIS_EDITOR_PASSWORD_HASH=scrypt:15:8:1:…

# Optional limits for saved and ad-hoc queries (defaults shown).
# ARRAKIS_QUERY_TIMEOUT_MS=30000         editor previews
# ARRAKIS_MATERIALIZE_TIMEOUT_MS=120000  stored and scheduled runs
# ARRAKIS_QUERY_CONCURRENCY=3            simultaneous queries per network
# ARRAKIS_RESULT_ROW_LIMIT=5000000       rows kept per stored result
