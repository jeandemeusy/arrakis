# The databases Arrakis queries: PostgreSQL, each through a role that can only
# read. `queryDatabaseUrl`, optional, is where saved queries run (a replica).
DATA_SOURCES='[{"id":"prod","label":"Production","databaseUrl":"postgresql://reader:change-me@db:5432/app"}]'

# One source alternative, still supported.
# DATABASE_URL=postgresql://reader:change-me@db:5432/app
# QUERY_DATABASE_URL=postgresql://reader:change-me@replica:5432/app

# Arrakis's own database: saved queries, their results, charts, dashboards,
# lists and sessions. Separate from every data source; migrated on start.
APP_DATABASE_URL=postgresql://arrakis:change-me@app-db:5432/arrakis

# Where hand-written chart SQL runs: the same database, as a role of its own
# that holds nothing (no table, no membership). Without it, SQL charts are off.
APP_CHARTS_DATABASE_URL=postgresql://arrakis_charts:change-me@app-db:5432/arrakis

# Editing is unlocked with one password. Store its hash, never the password:
#   npm run hash-password
# ARRAKIS_EDITOR_PASSWORD_HASH=scrypt:15:8:1:…

# A second hostname the studio is served from, for its writes to be accepted.
# ARRAKIS_ALLOWED_ORIGINS=https://arrakis.example.com

# Where the caller's address comes from, for login throttling and rate limits:
# the number of proxies in front, which each append to X-Forwarded-For...
# ARRAKIS_TRUSTED_PROXIES=1
# ...or a header the proxy sets outright, used instead.
# ARRAKIS_CLIENT_IP_HEADER=x-real-ip

# Limits for queries (defaults shown).
# ARRAKIS_QUERY_TIMEOUT_MS=30000         editor previews
# ARRAKIS_MATERIALIZE_TIMEOUT_MS=120000  stored and scheduled runs
# ARRAKIS_QUERY_TIMEOUT_MAX_MS=600000    ceiling on a query's own time limit
# ARRAKIS_RESULT_ROW_LIMIT=5000000       rows kept per stored result
# ARRAKIS_QUERY_CONCURRENCY=3            queries at once on each data source
# ARRAKIS_SCHEDULER_CONCURRENCY=2        scheduled runs at once
# ARRAKIS_CHART_CONCURRENCY=4            charts computed at once
# ARRAKIS_CHART_QUEUE=32                 charts waiting before a 429
# ARRAKIS_READ_RATE_LIMIT=300            signed-out data requests a minute per address
# ARRAKIS_SCHEDULER=0                    turn the scheduler off on this replica
